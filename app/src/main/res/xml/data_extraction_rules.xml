<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Estado transaccional local: no debe restaurarse desde la nube. -->
        <exclude domain="sharedpref" path="vapeon_carrito_prefs.xml" />
        <exclude domain="sharedpref" path="vapeon_checkout.xml" />
        <exclude domain="sharedpref" path="vapeon_pagos_simulados.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Tampoco debe copiarse durante una transferencia entre dispositivos. -->
        <exclude domain="sharedpref" path="vapeon_carrito_prefs.xml" />
        <exclude domain="sharedpref" path="vapeon_checkout.xml" />
        <exclude domain="sharedpref" path="vapeon_pagos_simulados.xml" />
    </device-transfer>
</data-extraction-rules>
